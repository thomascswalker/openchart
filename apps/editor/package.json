{
  "name": "@midiedit/editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://thomascswalker.github.io/midiview",
  "scripts": {
    "dev": "vite",
    "dev:geometry": "vite --open /geometry.html",
    "build": "tsc -b && vite build",
    "build:desktop": "tsc -b && vite build --mode desktop",
    "check-types": "tsc -b",
    "lint": "eslint .",
    "test": "npm run test:unit && vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@midiedit/core": "1.0.0",
    "@midiedit/views": "^1.0.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "choices.js": "^11.2.4",
    "classnames": "^2.5.1",
    "es-toolkit": "^1.51.0",
    "fix": "0.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "styled-system": "^5.1.5",
    "three": "^0.180.0",
    "ts-audio": "^0.8.1",
    "vite-plugin-svgr": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/styled-system": "^5.1.25",
    "@types/three": "^0.180.0",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "gh-pages": "^6.1.1",
    "globals": "^17.11.0",
    "playwright": "latest",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
