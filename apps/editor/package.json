{
  "name": "@openchart/editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://thomascswalker.github.io/openchart",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:desktop": "tsc -b && vite build --mode desktop",
    "check-types": "tsc -b",
    "lint": "eslint .",
    "test": "npm run test:unit && vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:storybook": "playwright test --config playwright.storybook.config.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@openchart/midi": "1.0.0",
    "@openchart/mixer": "^1.0.0",
    "@openchart/views": "^1.0.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.21",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-process": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.0.0",
    "choices.js": "^11.2.4",
    "classnames": "^2.5.1",
    "es-toolkit": "^1.51.0",
    "fix": "0.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-select": "^5.10.2",
    "styled-system": "^5.1.5",
    "three": "^0.180.0",
    "usehooks-ts": "^3.1.1",
    "vite-plugin-svgr": "^5.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/styled-system": "^5.1.25",
    "@types/three": "^0.180.0",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "gh-pages": "^6.1.1",
    "globals": "^17.11.0",
    "playwright": "latest",
    "storybook": "^10.6.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.12"
  },
  "imports": {
    "#usePlaybackMock": "./src/hooks/usePlayback.mock.ts",
    "#usePlayback": {
      "types": "./src/hooks/usePlayback.ts",
      "storybook": "./src/hooks/usePlayback.mock",
      "default": "./src/hooks/usePlayback"
    }
  }
}
