{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Music Track Metaschema",
  "type": "object",
  "required": ["Version", "ID", "Song", "Chart", "Difficulty", "Credits"],
  "properties": {
    "Version": { "type": "integer" },
    "ID": { "type": "string" },
    "Song": {
      "type": "object",
      "required": [
        "Name",
        "Artist",
        "Album",
        "Genre",
        "Year",
        "AlbumTrack",
        "Cover",
        "CoverArtist",
        "VocalGender"
      ],
      "properties": {
        "Name": { "type": "string" },
        "Artist": { "type": "string" },
        "Album": { "type": "string" },
        "Genre": { "type": "string" },
        "Year": { "type": "integer" },
        "AlbumTrack": { "type": "integer", "minimum": 1 },
        "Cover": { "type": "boolean" },
        "CoverArtist": { "type": "string" },
        "VocalGender": { "type": "string" }
      }
    },
    "Chart": {
      "type": "object",
      "required": ["Author", "PreviewStart", "PreviewEnd"],
      "properties": {
        "Author": { "type": "string" },
        "PreviewStart": { "type": "number", "minimum": 0 },
        "PreviewEnd": { "type": "number", "minimum": 0 }
      }
    },
    "Difficulty": {
      "type": "object",
      "required": [
        "Band",
        "LeadGuitar",
        "BassGuitar",
        "Drums",
        "ProDrums",
        "Vocals",
        "Harmony"
      ],
      "properties": {
        "Band": { "type": "integer" },
        "LeadGuitar": { "type": "integer" },
        "BassGuitar": { "type": "integer" },
        "Drums": { "type": "integer" },
        "ProDrums": { "type": "integer" },
        "Vocals": { "type": "integer" },
        "Harmony": { "type": "integer" }
      }
    },
    "Credits": {
      "type": "object",
      "required": ["Publisher", "Writer"],
      "properties": {
        "Publisher": { "type": "string" },
        "Writer": { "type": "string" }
      }
    }
  }
}
