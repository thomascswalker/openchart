{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenChart Workflow Desktop",
  "version": "0.1.0",
  "identifier": "com.openchart.workflowdesktop",
  "build": {
    "beforeDevCommand": "npm run dev --workspace=@openchart/workflow",
    "beforeBuildCommand": "npm run build --workspace=@openchart/workflow",
    "devUrl": "http://localhost:5174",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenChart Workflow Desktop",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["openchart"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "copyright": "© OpenChart",
    "shortDescription": "OpenChart Workflow Desktop foundation shell",
    "longDescription": "A minimal GUI shell for future repository and MIDI workflows."
  }
}
