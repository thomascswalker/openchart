# Frontend (safe to expose)
VITE_GITHUB_WEB_CLIENT_ID=your_web_oauth_client_id
VITE_GITHUB_DESKTOP_CLIENT_ID=your_desktop_oauth_client_id
VITE_AUTH_PROXY_URL=http://localhost:3000/api/auth/github/token
VITE_TAURI_DEEP_LINK_SCHEME=openchart

# Backend / serverless proxy only (NEVER prefix with VITE_)
GITHUB_WEB_CLIENT_ID=your_web_oauth_client_id
GITHUB_WEB_CLIENT_SECRET=your_web_oauth_client_secret
GITHUB_DESKTOP_CLIENT_ID=your_desktop_oauth_client_id
GITHUB_DESKTOP_CLIENT_SECRET=your_desktop_oauth_client_secret
