{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenChart",
  "version": "0.1.0",
  "identifier": "com.openchart.desktop",
  "build": {
    "beforeBuildCommand": "npm run build:desktop --workspace=@openchart/editor",
    "beforeDevCommand": "npm run dev --workspace=@openchart/editor",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../editor/dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenChart",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "wix": {
        "template": "wix/main.wxs"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDczNEZFMjlCMzBEM0FEQzUKUldURnJkTXdtK0pQYzBEWU5pcWtnRzc4TGdRTnFOcDR0Zzc5TDBwd2xTYXVyUUVQNjRaTzEwOCsK",
      "endpoints": [
        "https://github.com/thomascswalker/openchart/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
