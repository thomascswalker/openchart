{
  "semi": true,
  "trailingComma": "all",
  "singleQuote": true,
  "printWidth": 80,
  "tabWidth": 2,
  "plugins": ["@trivago/prettier-plugin-sort-imports"],
  "importOrder": ["^react", "<THIRD_PARTY_MODULES>", "^@src/(.*)$", "^[./]"],
  "importOrderParserPlugins": [
    "decorators-legacy",
    "typescript",
    "jsx",
    "classProperties"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true
}
