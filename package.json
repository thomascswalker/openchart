{
  "name": "midiedit",
  "version": "1.0.0",
  "description": "",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "help": "turbo --help",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "test": "turbo run test",
    "test:core": "turbo run test --filter=@midiedit/core",
    "test:views": "turbo run test --filter=@midiedit/views",
    "deploy:editor": "turbo run build --filter=@midiedit/editor^... && npm run deploy --workspace=@midiedit/editor"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomascswalker/midiview.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/thomascswalker/midiview/issues"
  },
  "homepage": "https://github.com/thomascswalker/midiview#readme",
  "dependencies": {
    "pixi.js": "^8.20.1"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/wicg-file-system-access": "^2023.10.7",
    "gh-pages": "^6.3.0",
    "prettier": "^3.9.6",
    "turbo": "latest",
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11"
    }
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
