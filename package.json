{
  "name": "midiedit",
  "version": "1.1.0",
  "description": "",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "help": "turbo --help",
    "build": "turbo run build",
    "build:desktop": "turbo run build:desktop",
    "desktop:dev": "npm run dev:desktop",
    "desktop:build": "npm run build --workspace=@midiedit/desktop",
    "dev": "npm run dev:web",
    "dev:web": "turbo run dev --filter=@midiedit/editor",
    "dev:geometry": "npm run dev:geometry --workspace=@midiedit/editor",
    "dev:desktop": "npm run dev --workspace=@midiedit/desktop",
    "lint": "eslint --config eslint.config.js .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check",
    "test": "turbo run test",
    "test:core": "turbo run test --filter=@midiedit/core",
    "test:views": "turbo run test --filter=@midiedit/views",
    "deploy:editor": "turbo run build --filter=@midiedit/editor^... && npm run deploy --workspace=@midiedit/editor"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomascswalker/midiview.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/thomascswalker/midiview/issues"
  },
  "homepage": "https://github.com/thomascswalker/midiview#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "turbo": "latest",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11"
    }
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "fix": "^0.0.3"
  }
}
