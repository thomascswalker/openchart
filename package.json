{
  "name": "openchart",
  "version": "0.3.2",
  "description": "",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "help": "turbo --help",
    "build": "turbo run build",
    "build:desktop": "turbo run build:desktop",
    "lock": "npm install --package-lock-only",
    "desktop:dev": "npm run dev:desktop",
    "desktop:build": "npm run build --workspace=@openchart/desktop",
    "dev": "npm run dev:web",
    "dev:web": "turbo run dev --filter=@openchart/editor",
    "dev:desktop": "npm run dev --workspace=@openchart/desktop",
    "storybook": "npm run storybook --workspace=@openchart/editor",
    "build-storybook": "npm run build-storybook --workspace=@openchart/editor",
    "ci": "npm run format && npm run lint && npm run check-types && npm run test && npm run test:e2e --workspace=@openchart/editor && npm run test:storybook --workspace=@openchart/editor",
    "lint": "eslint --config eslint.config.js .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run check:editing:strict && npm run format:check",
    "test": "turbo run test",
    "check-types": "turbo run check-types --filter=!@openchart/desktop",
    "check:editing": "node scripts/check-editing-boundaries.mjs",
    "check:editing:strict": "node scripts/check-editing-boundaries.mjs --strict",
    "test:core": "turbo run test --filter=@openchart/midi",
    "test:views": "turbo run test --filter=@openchart/views",
    "test:audio": "turbo run test --filter=@openchart/audio",
    "test:storybook": "npm run test:storybook --workspace=@openchart/editor",
    "deploy:editor": "turbo run build --filter=@openchart/editor^... && npm run deploy --workspace=@openchart/editor"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomascswalker/openchart.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/thomascswalker/openchart/issues"
  },
  "homepage": "https://github.com/thomascswalker/openchart#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.10",
    "turbo": "latest",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11"
    }
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "fix": "^0.0.3"
  }
}
