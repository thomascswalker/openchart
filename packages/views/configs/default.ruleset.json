{
  "$schema": "./schema.json",
  "schemaVersion": "2.0.0",
  "profile": {
    "id": "default",
    "name": "Default",
    "targetGame": "Any",
    "specVersion": "25_11_06_01",
    "description": "Default chart format."
  },
  "detection": {
    "requiredTracks": ["CHART HEADER"]
  },
  "midi": {
    "fileFormat": 1,
    "timeDivision": "ticksPerQuarter",
    "recommendedResolution": 480,
    "trackNameEvent": {
      "mustBeFirstEvent": true,
      "mustBeAtTickZero": true
    },
    "noteDefaults": {
      "endTickInclusive": false,
      "allowZeroLength": false,
      "zeroLengthSeverity": "error"
    },
    "conventions": {
      "channel": 0,
      "nominalVelocity": 100,
      "severity": "info"
    },
    "tempoMap": {
      "timeSignatureMustAlignToMeasure": true,
      "severity": "error"
    }
  },
  "textEventGrammar": {
    "metaEventTypes": [1],
    "encoding": "utf-8",
    "brackets": "required",
    "componentSyntax": "structured",
    "allowUnderscoreAsSpace": false,
    "caseSensitive": true,
    "stringEscapes": ["\\\"", "\\\\"]
  },
  "policies": {
    "unknownTrack": "warning",
    "unknownPitch": "error",
    "reservedPitch": "error",
    "unknownTextEvent": "error",
    "vocabularyMismatch": "error"
  },
  "settingsSources": [
    {
      "id": "infoJson",
      "file": "info.json",
      "keys": [
        {
          "name": "HopoThreshold",
          "type": "integer",
          "unit": "ticks",
          "default": 160
        },
        {
          "name": "SustainCutoff",
          "type": "integer",
          "unit": "ticks",
          "default": 160
        },
        {
          "name": "PositionSnap",
          "type": "integer",
          "unit": "ticks",
          "default": 16
        },
        {
          "name": "SustainGap",
          "type": "number",
          "unit": "seconds",
          "default": 0.07
        }
      ]
    }
  ],
  "playerOptions": [
    {
      "id": "expertPlus",
      "description": "Player selected Expert+."
    }
  ],
  "vocabularies": {
    "practiceSectionIds": {
      "values": [],
      "enforce": false,
      "source": "Translatable section list linked from the spec (not included in the PDF)."
    },
    "directedCutIds": {
      "values": [],
      "enforce": false,
      "source": "Cut ID list linked from the spec."
    },
    "lightingPresetIds": {
      "values": [],
      "enforce": false,
      "source": "Lighting preset list linked from the spec."
    },
    "drumAnimationIds": {
      "values": [],
      "enforce": false,
      "source": "Drummer animation ID list linked from the spec."
    }
  },
  "tracks": [
    {
      "id": "chartHeader",
      "kind": "header",
      "trackNames": ["CHART HEADER"],
      "required": true,
      "position": 1,
      "description": "MUST be the first track after the sync track; distinguishes this format from custom-song .mid.",
      "textEvents": [
        {
          "id": "version",
          "identifier": "version",
          "arguments": [
            {
              "name": "value",
              "type": "identifier",
              "description": "YY_MM_DD_RR, compared as text, not parsed as a number."
            }
          ],
          "maxOccurrences": 1
        }
      ],
      "versionCheck": {
        "textEvent": "version",
        "argument": "value",
        "accepted": ["25_11_06_01"],
        "compareAs": "string",
        "onMissing": "error",
        "onMismatch": "warning"
      },
      "unknownPitchPolicy": "error"
    },
    {
