          "overrides": [
            {
              "source": "infoJson",
              "key": "SustainGap"
            }
          ],
          "description": "Sustains auto-shortened to leave this gap before the next note."
        },
        "positionSnap": {
          "enabled": true,
          "threshold": {
            "value": {
              "unit": "step",
              "denominator": 120
            },
            "inclusive": true,
            "maxTicks": 16,
            "overrides": [
              {
                "source": "infoJson",
                "key": "PositionSnap"
              }
            ]
          },
          "appliesToSustainEnds": true,
          "description": "Snaps backwards to the previous note to form a chord; also aligns chord sustain ends."
        }
      },
